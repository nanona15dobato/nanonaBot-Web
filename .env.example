# =====================================================================
# NanonaBot Tool - 環境変数サンプル
#
# Toolforge本番環境では、このファイルをそのまま使うのではなく
# `toolforge envvars create KEY` で1つずつ登録することを推奨する
# （Help:Toolforge/Envvars参照）。ローカル開発時はこのファイルを
# `.env` にコピーして使う。
# =====================================================================

# --- サーバー ---
# ToolforgeのKubernetesバックエンドでは常に8000固定で自動設定される。
# ローカル開発時のみ明示的に指定する。
PORT=8000
# https://<toolname>.toolforge.org のようにコールバックURL組み立てに使う
TOOL_BASE_URL=http://localhost:8000

# --- Wikimedia OAuth 2.0 ---
# meta.wikimedia.org の Special:OAuthConsumerRegistration で
# 「OAuth 2.0」「Authorization code」グラントタイプで登録して取得する
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# 登録時に指定したリダイレクトURIと完全一致させること
OAUTH_CALLBACK_URL=http://localhost:8000/oauth/callback
# 認可・トークン取得に使うホスト（通常はmeta.wikimedia.orgのまま）
OAUTH_WIKI_HOST=meta.wikimedia.org

# --- 権限 ---
# フル操作権限を持つ唯一のアカウント
OWNER_USERNAME=Nanona15dobato
# 「管理者(sysop)なら緊急停止のみ可」の判定に使うウィキ
ADMIN_CHECK_WIKI_HOST=ja.wikipedia.org

# --- セッション ---
# 32文字以上のランダム文字列を推奨（例: `openssl rand -hex 32`）
SESSION_SECRET=

# --- ToolsDB ---
# Toolforge本番ではreplica.my.cnfから自動取得するため未使用。
# `<credentialUser>__<この値>` がデータベース名になる
TOOLSDB_DATABASE_SUFFIX=nanona_bot

# --- ローカル開発用DB接続（Toolforge本番では未使用。replica.my.cnfが優先される） ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- 運用設定 ---
# 終わったタスクのtask_pages（作業データ）を残す日数（9.4節）。過ぎたらワーカーが自動で削除する。0で削除しない
TASK_PAGES_RETENTION_DAYS=14
# 上記の削除を実行する間隔（ミリ秒。既定1時間）
CLEANUP_INTERVAL_MS=3600000
# 編集が一時的に失敗したときの再試行回数と、1回目の待ち時間（ミリ秒。2回目以降は倍々に延ばす）
EDIT_RETRY_COUNT=3
EDIT_RETRY_BASE_MS=10000
# Category系ルールでテンプレート使用ページを更新する間隔（ミリ秒。null edit 1件／purge 1バッチごと）
NULL_EDIT_INTERVAL_MS=1000

# --- 通知（任意。フェーズ9） ---
# Slack Incoming Webhook または Discord Webhook のURL。空なら通知しない
NOTIFY_WEBHOOK_URL=
# メール通知（Toolforgeのmail.tools.wmcloud.org経由）。宛先・送信者の両方を設定すると送る。
# Fromは「ツール名.任意の文字列@toolforge.org」形式にすること（Help:Toolforge/Email）
NOTIFY_MAIL_TO=
# 例: "nanonaBotWeb:Error" <nanonabot01.weberror@toolforge.org>
NOTIFY_MAIL_FROM=
# SMTPサーバー（通常は変更不要）
SMTP_HOST=mail.tools.wmcloud.org
SMTP_PORT=25
# 通知する種類（カンマ区切り。空なら全部）:
# emergency_stop,emergency_clear,paused,failed,expired,emergency_stopped,completed_with_failures,completed
NOTIFY_EVENTS=

# --- Bot編集アカウント（フェーズ2以降のワーカーで使用。フェーズ1では未使用） ---
BOT_NANONA15DOBATO_USER=
BOT_NANONA15DOBATO_PASS=
BOT_NANONABOT_USER=
BOT_NANONABOT_PASS=
BOT_NANONABOT3_USER=
BOT_NANONABOT3_PASS=
